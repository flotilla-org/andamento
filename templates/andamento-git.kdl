version 1

// Optional catalog presentation for producers that publish repository entities.
region "repositories" root-template="repositories/title" form="compact" placement="repositories"
placement "repositories" {
  for "repo" kind="repo" {
    order "display.label"
    apply-template "repo/line"
  }
}
template "repositories/title" {
  field "label" source="literal" value="Repositories"
}
template "repo/line" {
  toggle collapsed="▶" expanded="▼"
  field "label" key="display.label"
  for "checkout" kind="checkout" {
    match "vcs.repo" of="repo"
    field "label" key="display.label"
    field "branch" key="git.branch"
  }
}
