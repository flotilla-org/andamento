version 1

variable "convoy.tier" default="full" {
  value "full"
  value "medium"
  value "short"
}
variable "issue.tier" default="full" {
  value "full"
  value "medium"
  value "short"
}

region "attention" root-template="flotilla/region/attention" form="compact" placement="attention" pinned=true
region "tree" root-template="flotilla/region/tree" form="compact" placement="projects"
region "git" root-template="git/title" form="compact" placement="git"
region "controls" root-template="flotilla/region/controls" form="compact" pinned=true

placement "attention" {
  for "attention" {
    match "status.attention" value="true"
  }
}
placement "projects" {
  for "project" kind="project" layout="lines" {
    order "display.label"
    apply-template "project/line"
  }
}
template "project/line" {
  toggle collapsed="▶" expanded="▼"
  field "label" key="display.label"
  for "independent" kind="role" layout="inline" {
    match "flotilla.project" of="project"
    field "label" key="display.label"
  }
  for "convoy" kind="convoy" layout="lines" {
    match "flotilla.project" of="project"
    order "display.label"
    apply-template "convoy/line"
  }
  for "issue" kind="issue" layout="row" {
    match "flotilla.project" of="project"
    field "label" source="metadata-first-token" key="display.label"
  }
}
template "convoy/line" {
  toggle collapsed="▶" expanded="▼"
  field "label" key="display.label"
  for "vessel" kind="vessel" layout="lines" {
    match "flotilla.convoy" of="convoy"
    apply-template "vessel/line"
  }
}
template "vessel/line" {
  toggle collapsed="▶" expanded="▼"
  field "label" key="display.label"
  for "session" kind="session" layout="lines" {
    match "flotilla.vessel" of="vessel"
    field "label" key="display.label"
  }
}
template "flotilla/region/attention" slot="compact" node-kind="entity" {
  field "label" source="literal" value="⚠ Attention"
}
template "flotilla/region/tree" slot="compact" node-kind="entity" {
  field "label" source="literal" value=""
}
template "flotilla/region/controls" slot="compact" node-kind="entity" {
  control "open-config" glyph="⚙"
  control "scroll-down" glyph="▼"
  control "scroll-up" glyph="▲"
  control "inspect-root"
}

template "flotilla/issue/compact" slot="compact" node-kind="entity" {
  field "label" class="required" source="metadata-first-token" key="display.label"
}

template "flotilla/issue/detail" slot="detail" node-kind="entity" {
  field "label" class="required" key="display.label"
  field "summary" class="priority" key="summary.text" priority=50
}

template "flotilla/entity/compact" slot="compact" node-kind="entity" {
  field "label" class="required" {
    value source="metadata-text" key="display.label"
    value source="metadata-text" key="entity.id"
  }
  field "summary" class="priority" key="summary.text" priority=50
}

template "flotilla/entity/detail" slot="detail" node-kind="entity" {
  field "label" class="required" {
    value source="metadata-text" key="display.label"
    value source="metadata-text" key="entity.id"
  }
  field "summary" class="priority" key="summary.text" priority=50
}

// Host-independent git inventory.

placement "git" {
  for "repo" kind="repo" layout="lines" tier="medium" {
    order "display.label"
    apply-template "repo/git"
  }
}
template "git/title" slot="compact" node-kind="entity" {
  field "label" source="literal" value="Git"
}
template "repo/git" {
  toggle collapsed="▶" expanded="▼"
  field "label" key="display.label"
  for "worktree" kind="worktree" layout="lines" tier="full" {
    match "git.repo" of="repo"
    order "display.label"
    apply-template "worktree/git"
  }
}
template "worktree/git" {
  field "label" key="display.label"
  field "branch" key="git.branch"
  field "dirty" key="git.dirty"
  field "state" key="status.state"
}
