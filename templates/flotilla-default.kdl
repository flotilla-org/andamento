version 1

variable "show-issues" type="bool" default=true label="Issues" icon="I" persist=true

grouping "flotilla.default" priority=-1000 {
  filter key="entity.kind"

  presence kind="convoy" class="tab"
  presence kind="vessel" class="tab"
  presence kind="session" class="tab"
  presence kind="issue" class="section" form="compact" visible-when="show-issues"
  presence kind="project" class="tab"
  presence kind="repo" class="section"
  presence kind="checkout" class="section"

  level key="flotilla.project" label-key="flotilla.project.name" optional=true show-empty=true
  level key="vcs.repo" label-key="vcs.repo.name" optional=true
  level key="flotilla.convoy" label-key="flotilla.convoy.name" optional=true collapse-single-member=true
  level key="flotilla.vessel" label-key="flotilla.vessel.name" optional=true
  level key="flotilla.session" label-key="display.label" optional=true
  level key="flotilla.issue" label-key="display.label" optional=true show-empty=true
  level key="flotilla.checkout" label-key="display.label" optional=true show-empty=true
}

fragment "flotilla/group-toggle" {
  field "toggle" class="required" source="collapsed-toggle" collapsed="▶" expanded="▼"
}

fragment "flotilla/group-label" {
  field "label" class="required" {
    value source="metadata-text" key="group.segment.label"
    value source="metadata-text-basename" key="group.value"
    value source="metadata-text" key="group.label"
  }
}

fragment "flotilla/group-label-verbatim" {
  field "label" class="required" {
    value source="metadata-text" key="group.segment.label"
    value source="metadata-text" key="group.value"
    value source="metadata-text" key="group.label"
  }
}

template "flotilla/project/full" slot="group-header" node-kind="group" {
  use "flotilla/group-toggle"
  use "flotilla/group-label-verbatim"
}

template "flotilla/repo/full" slot="group-header" node-kind="group" {
  use "flotilla/group-toggle"
  use "flotilla/group-label"
}

template "flotilla/convoy/full" slot="group-header" node-kind="group" {
  use "flotilla/group-toggle"
  use "flotilla/group-label"
}

template "flotilla/vessel/full" slot="group-header" node-kind="group" {
  use "flotilla/group-toggle"
  use "flotilla/group-label"
}

template "flotilla/session/full" slot="group-header" node-kind="group" {
  use "flotilla/group-toggle"
  use "flotilla/group-label"
}

template "flotilla/issue/full" slot="group-header" node-kind="group" {
  use "flotilla/group-toggle"
  use "flotilla/group-label"
}

template "flotilla/checkout/full" slot="group-header" node-kind="group" {
  use "flotilla/group-toggle"
  use "flotilla/group-label"
}

template "flotilla/group/full" slot="group-header" node-kind="group" {
  use "flotilla/group-toggle"
  field "label" class="required" {
    value source="metadata-text" key="group.label"
    value source="literal" value="group"
  }
  field "count" class="optional" source="metadata-display" key="group.tab_count" prefix="(" suffix=")"
  field "active" class="priority" source="active-tab-name" prefix=": " condition="collapsed"
}

template "flotilla/tab/title" slot="tab-title" node-kind="tab" {
  field "title" class="required" {
    value source="metadata-text" key="zellij.tab.name"
    value source="tab-number"
    value source="literal" value="Tab"
  }
}

template "flotilla/tab/status" slot="tab-status" node-kind="tab" {
  field "title" class="required" source="metadata-text" key="status.title"
  field "detail" class="priority" source="metadata-text" key="status.detail" prefix=": "
}

template "flotilla/issue/compact" slot="compact" node-kind="entity" {
  field "label" class="required" source="metadata-first-token" key="display.label"
}

template "flotilla/issue/detail" slot="detail" node-kind="entity" {
  field "label" class="required" key="display.label"
  field "summary" class="priority" key="summary.text" priority=50
}
