plugins {
    tabs-controller location="file:$ANDAMENTO_ROOT/target/wasm32-wasip1/release/tabs-controller.wasm" {
        rail_structure "joined-cells"
        rail_sizing "active-large"
        rail_grouping "directory"
        template_config_path "/host/Users/robert/dev/zellij-scratch.native-tabs/templates/andamento-git.kdl"
        grouping_config_path "/host/Users/robert/dev/zellij-scratch.native-tabs/templates/andamento-git.kdl"
    }
    tabs-rail location="file:$ANDAMENTO_ROOT/target/wasm32-wasip1/release/tabs-rail.wasm" {
        controller_plugin_url "tabs-controller"
        config_plugin_url "tabs-rail-config"
        rail_placement "left"
    }
    tabs-rail-config location="file:$ANDAMENTO_ROOT/target/wasm32-wasip1/release/tabs-rail-config.wasm"
}

load_plugins {
    tabs-controller
}

layout {
    default_tab_template {
        pane split_direction="vertical" {
            pane size="23%" borderless=true {
                plugin location="tabs-rail"
            }
            children
        }
        pane size=2 borderless=true {
            plugin location="status-bar"
        }
    }

    new_tab_template {
        pane split_direction="vertical" {
            pane size="23%" borderless=true {
                plugin location="tabs-rail"
            }
            pane
        }
        pane size=2 borderless=true {
            plugin location="status-bar"
        }
    }

    tab name="main" hide_floating_panes=true {
        pane
        floating_panes {
            pane command="$ANDAMENTO_ROOT/scripts/andamento-git-watcher.py" cwd="$ANDAMENTO_ROOT" {
                args "--interval" "5"
                width 80
                height 12
                x 10
                y 5
            }
        }
    }
}
